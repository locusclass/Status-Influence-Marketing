PORT=3000
DATABASE_URL=postgres://user:pass@localhost:5432/dbname
JWT_SECRET=change_me
CORS_ORIGIN=http://localhost:*,http://127.0.0.1:*,https://status-influence-marketing-production.up.railway.app
API_BASE_URL=https://status-influence-marketing-production.up.railway.app/api
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
VERIFIER_PROVIDER=python_bot
PYTHON_EXECUTABLE=python3
PYTHON_VERIFIER_SCRIPT=/app/apps/worker/scripts/wa_status_verifier.py
WA_VERIFIER_FPS=2
WA_VERIFIER_MAX_SECONDS=60

# Flutterwave v3
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
FLUTTERWAVE_PUBLIC_KEY=optional_flutterwave_public_key
FLUTTERWAVE_WEBHOOK_SECRET_HASH=your_flutterwave_webhook_secret_hash

# WhatsApp verification
# Use `baileys` in production, `mock` for local/testing.
WHATSAPP_VERIFICATION_MODE=mock
# Required when mode=baileys. A folder where Baileys stores auth credentials.
WHATSAPP_BAILEYS_AUTH_DIR=.baileys_auth_state
# Optional for headless production pairing (Railway, etc.).
WHATSAPP_ENABLE_PAIRING=false
# Enter digits only, with country code, e.g. 2567XXXXXXXX
WHATSAPP_PAIRING_NUMBER=
# Used when mode=mock. Comma-separated list of accepted prefixes.
WHATSAPP_MOCK_ALLOWED_PREFIXES=+256,+254,+255,+250,+

